#!/usr/bin/make -f

export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_build:
	$(MAKE) all

override_dh_auto_install:
	# No extract alias in the .deb — avoids clashing with libextractor.
	$(MAKE) install PREFIX=/usr DESTDIR=$(CURDIR)/debian/pack-unpack INSTALL_EXTRACT_ALIAS=0

override_dh_auto_test:
	$(MAKE) check
