# shellcheck disable=SC2034,SC2154
# Prebuilt binaries from GitHub Releases — no compile step.
pkgname=pack-unpack-bin
pkgver=1.5.7
pkgrel=1
pkgdesc="Create and unpack archives via libarchive (prebuilt pack/unpack)"
arch=('x86_64')
url="https://github.com/IRodriguez13/pack-unpack"
license=('GPL-3.0-or-later')
depends=('libarchive')
provides=('pack-unpack')
conflicts=('pack-unpack')
options=('!strip')
source=("pack-unpack-${pkgver}-linux-amd64.tar.gz::${url}/releases/download/v${pkgver}/pack-unpack-${pkgver}-linux-amd64.tar.gz")
sha256sums=('128d27534647a27fb0a01f5faf8416428caefc78cf188e21b8433e228f58beba')

package() {
  cd "pack-unpack-${pkgver}-linux-amd64"
  install -Dm755 bin/pack "${pkgdir}/usr/bin/pack"
  install -Dm755 bin/unpack "${pkgdir}/usr/bin/unpack"
  install -Dm644 share/man/man1/pack.1 "${pkgdir}/usr/share/man/man1/pack.1"
  install -Dm644 share/man/man1/unpack.1 "${pkgdir}/usr/share/man/man1/unpack.1"
}
