# shellcheck disable=SC2034,SC2154
# Prebuilt binaries from GitHub Releases — no compile step.
pkgname=pack-extract-bin
pkgver=1.5.5
pkgrel=1
pkgdesc="Create and extract archives via libarchive (prebuilt pack/extract)"
arch=('x86_64')
url="https://github.com/IRodriguez13/pack-extract"
license=('GPL-3.0-or-later')
depends=('libarchive')
provides=('pack-extract')
conflicts=('pack-extract')
options=('!strip')
source=("pack-extract-${pkgver}-linux-amd64.tar.gz::${url}/releases/download/v${pkgver}/pack-extract-${pkgver}-linux-amd64.tar.gz")
sha256sums=('776ef525be3c5f6eff3c03d1e698ec2f25dc4e72acfaeae87eeae669d2d8683a')

package() {
  cd "pack-extract-${pkgver}-linux-amd64"
  install -Dm755 bin/pack "${pkgdir}/usr/bin/pack"
  install -Dm755 bin/extract "${pkgdir}/usr/bin/extract"
  install -Dm644 share/man/man1/pack.1 "${pkgdir}/usr/share/man/man1/pack.1"
  install -Dm644 share/man/man1/extract.1 "${pkgdir}/usr/share/man/man1/extract.1"
}
