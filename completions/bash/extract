# bash completion for extract(1) — optional alias of unpack(1) -*- shell-script -*-

_extract()
{
    local cur prev words cword
    _init_completion || return

    local flags='--help --version --verbose --directory --force --no-clobber --interactive -h -v -C -f -n -i'

    case $prev in
        -h|--help|--version)
            return
            ;;
        -C|--directory)
            compopt -o filenames 2>/dev/null
            COMPREPLY=( $( compgen -d -- "$cur" ) )
            return
            ;;
    esac

    if [[ $cur == -* ]]; then
        COMPREPLY=( $( compgen -W "$flags" -- "$cur" ) )
        return
    fi

    compopt -o filenames 2>/dev/null
    COMPREPLY=( $( compgen -f -- "$cur" ) )
} &&
    complete -F _extract extract

# ex: filetype=sh
