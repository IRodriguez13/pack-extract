# bash completion for pack(1) -*- shell-script -*-

_pack()
{
    local cur prev words cword split
    _init_completion -s || return

    local formats='tar tar.gz tar.xz tar.bz2 tar.zst tar.lz4 tar.lz tar.lzo tar.br zip 7z gz bz2 xz zstd lz4 lzo br'
    local flags='--help --version --verbose --output -h -v -o'

    case $prev in
        -h|--help|--version)
            return
            ;;
        -o|--output)
            compopt -o filenames 2>/dev/null
            COMPREPLY=( $( compgen -f -- "$cur" ) )
            return
            ;;
    esac

    if [[ $cur == -* ]]; then
        COMPREPLY=( $( compgen -W "$flags" -- "$cur" ) )
        return
    fi

    # First non-option: format; rest: sources
    local i have_format=0
    for (( i=1; i < cword; i++ )); do
        case ${words[i]} in
            -o|--output)
                (( i++ ))
                continue
                ;;
            -*)
                continue
                ;;
            *)
                have_format=1
                break
                ;;
        esac
    done

    if (( have_format == 0 )); then
        COMPREPLY=( $( compgen -W "$formats $flags" -- "$cur" ) )
    else
        compopt -o filenames 2>/dev/null
        COMPREPLY=( $( compgen -f -- "$cur" ) )
    fi
} &&
    complete -F _pack pack

