#compdef pack

_pack() {
    local curcontext="$curcontext" state line
    typeset -A opt_args

    _arguments \
        '(-v --version)'{-v,--version}'[Show version information]' \
        '(-h --help)'{-h,--help}'[Show help message]' \
        '1:format:(tar tar.gz tar.xz tar.bz2 tar.zst tar.lz4 tar.lz tar.lzo tar.br zip 7z gz bz2 xz zstd lz4 lzo br)' \
        '2:source:_files'
}

_pack "$@"
